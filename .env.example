# Optional. By default the app talks to port 3000 on the machine running `expo start`
# (auto-detected, works for simulators and physical devices on the same Wi-Fi).
# Override when the API runs elsewhere, e.g. Android emulator without LAN: http://10.0.2.2:3000
# EXPO_PUBLIC_API_URL="http://192.168.1.20:3000"
